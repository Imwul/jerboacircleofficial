# Required for shared member/archive sync in Vercel.
JERBOA_SYNC_KEY=

# Required for server-verified keeper roles.
JERBOA_AUTH_SECRET=

# Optional owner key. Can authenticate both member-admin and archive-editor roles.
JERBOA_ADMIN_KEY=

# Optional role-specific keys.
JERBOA_MEMBER_ADMIN_KEY=
JERBOA_ARCHIVE_EDITOR_KEY=

# Optional analytics kill switch.
JERBOA_ANALYTICS_DISABLED=
